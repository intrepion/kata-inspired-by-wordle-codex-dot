  "rejected": [
    {
      "id": "9385ea6c5224339a",
      "reason": "Mamar has a literal human milk-taking infant reading, not just young animals. Pinned Spanish extract verb record 423d645652355810b9b5c137db7ba5644accbda5f7f0d9be16c18c71f3f08f21, zero-based sense 0, describes suction using the lips/throat, especially maternal milk from the breast, and marks use also intransitive (utci). A human former infant can truthfully say I suckled. Preserve the offspring-as-subject meaning; do not substitute the caregiver feeding role.",
      "proposedAction": "keep"
    },
    {
      "id": "135c4e7146f32a49",
      "reason": "Pinned Spanish extract trinar verb record 6a2708a9327f977206a21664af864e05083873a8b29dfdfb6f9f0f736b797eac, zero-based sense 1, gives Hacer trinos without the bird restriction attached to sense 0. Producing musical trills is human-capable and English warble permits singing with such ornaments. A blanket animal-only restriction loses this supported musical reading; preserve the musical sense rather than infer personification from the bird sense.",
      "proposedAction": "keep"
    }
  ]
